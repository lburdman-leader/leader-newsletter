{#
  The newspaper edition. Rendered from one NewsletterEdition object.

  Visual specification: design/LeaderIntelligenceSemanal.dc.html — the
  "Broadsheet" design system. Its tokens are inlined below; only the ramp steps
  the edition actually uses are carried, so the page stays small.

  Rules this template obeys:
  - autoescape is ON; no `| safe` anywhere, because headlines and summaries
    originate in scraped content;
  - every outbound URL comes from `item.source_url`, which was validated at
    ingestion; the only other links are the two paging arrows, which are built in
    renderer.py from an issue label the label pattern already accepted and are
    relative on purpose, so the same file pages correctly on disk and under the
    server;
  - no JavaScript, no external requests, no embedded webfont: the file is
    readable offline, forever, and prints without a network. "Source Serif 4"
    leads the stack so the page renders as designed where the family is
    installed, and falls back to a system serif everywhere else.

  Layout, after the artboard: a centred broadsheet masthead over an issue strip
  and the paging rail that lets a reader walk back through the weeks,
  the executive brief set in newspaper columns, then the lead story running
  around a filled rail that carries the first section, the remaining sections as
  a wrapping story grid, and the colophon. The reference design is photo-led;
  this publication has no images, so the weight the photograph carried is given
  to the rules, the drop cap and the accent fills.
#}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ edition.masthead }} — {{ edition.issue_label }}</title>
<meta name="description" content="Resumen semanal de inteligencia para {{ edition.period_start | issue_date }} al {{ edition.period_end | issue_date_end }}.">
<style>
  /* ---------- Broadsheet tokens ---------- */
  :root {
    --color-bg: #f3f2f2;
    --color-text: #201e1d;
    --color-accent: #0088b0;
    --color-accent-2: #d6006c;

    --color-neutral-300: #d7d3d3;
    --color-neutral-400: #bab6b6;
    --color-neutral-700: #605d5d;
    --color-neutral-800: #444141;

    --color-accent-100: #e9f8ff;
    --color-accent-300: #99e0ff;
    --color-accent-700: #006786;
    --color-accent-900: #0a303e;

    --space-1: 5px;
    --space-2: 10px;
    --space-3: 15px;
    --space-4: 20px;
    --space-6: 30px;
    --space-8: 40px;

    /* The design sets both roles to "Source Serif 4". The woff2 files are not
       embedded — 1.5 MB in an artifact that gets emailed and archived — so the
       stack degrades to whatever serif the reader already has. */
    --font-body: "Source Serif 4", Georgia, "Times New Roman", "Liberation Serif", serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: var(--space-6) var(--space-3) var(--space-8);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.55;
    -webkit-text-size-adjust: 100%;
  }

  .edition { max-width: 1180px; margin: 0 auto; }

  a { color: inherit; text-decoration: none; }
  a:hover, a:focus { color: var(--color-accent-700); text-decoration: underline; text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* ---------- masthead ---------- */
  .rule-heavy { height: 5px; background: var(--color-text); }
  .rule-hair { height: 1px; background: var(--color-text); }
  .rule-mid { height: 3px; background: var(--color-text); }
  .rule-heavy + .rule-hair { margin-top: 3px; }

  .masthead h1 {
    margin: 0;
    padding: var(--space-4) 0 var(--space-2);
    text-align: center;
    font-size: clamp(34px, 8.4vw, 92px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .masthead-tagline {
    margin: 0;
    padding-bottom: var(--space-3);
    text-align: center;
    font-size: 15px;
    font-style: italic;
    color: var(--color-neutral-800);
  }

  .issue-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: 6px 0;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .issue-label { font-weight: 700; color: var(--color-text); }
  .issue-strip .count { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }

  /* The call to action a reader sees without scrolling: it rides the issue
     strip, in the accent the design gives to every outbound link. */
  .submit-button { font-weight: 700; color: var(--color-accent-700); white-space: nowrap; }

  /* The paging rail, under the issue strip and inside the same masthead rules:
     one step back on the left, one step forward on the right, in the strip's own
     voice. A week nobody generated is set in the muted neutral and is a <span>,
     never an anchor — an arrow that goes nowhere is worse than one visibly
     spent. */
  .issue-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: 6px 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .issue-nav a { color: var(--color-accent-700); white-space: nowrap; }
  .issue-nav .spent { color: var(--color-neutral-400); white-space: nowrap; cursor: default; }

  /* ---------- executive brief ---------- */
  .brief {
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-text);
    border-bottom: 1px solid var(--color-text);
    padding: var(--space-3) 0 var(--space-4);
  }
  .brief-label {
    margin: 0 0 var(--space-3);
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-neutral-800);
  }
  .brief-columns {
    columns: 3 15rem;
    column-gap: var(--space-6);
    column-rule: 1px solid var(--color-neutral-300);
  }
  .brief-columns p {
    margin: 0 0 var(--space-3);
    font-size: 13.5px;
    line-height: 1.5;
    text-wrap: pretty;
    break-inside: avoid;
  }
  .brief-columns .n {
    margin-right: var(--space-2);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent-2);
  }

  /* ---------- lead + rail ---------- */
  .body-matter { padding-top: var(--space-6); }
  .body-matter::after { content: ""; display: block; clear: both; }

  .sidebar {
    margin: 0 0 var(--space-6);
    background: var(--color-accent-100);
    border-top: 4px solid var(--color-accent);
    padding: var(--space-4);
  }
  .sidebar h2 {
    margin: 0 0 var(--space-4);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-accent-900);
  }
  .sidebar .story {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: 1px solid var(--color-accent-300);
    padding-top: var(--space-3);
  }
  .sidebar .story + .story { margin-top: var(--space-4); }
  .sidebar .story h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .sidebar .summary { margin: 0; font-size: 13px; line-height: 1.5; color: var(--color-neutral-800); text-wrap: pretty; }
  .sidebar .why { margin: 0; font-size: 13px; font-style: italic; line-height: 1.45; text-wrap: pretty; }
  .sidebar .meta { margin: auto 0 0; font-size: 10.5px; }

  .lead { display: flex; flex-direction: column; }
  .lead-band {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    border-top: 3px solid var(--color-text);
    padding: var(--space-2) 0 var(--space-3);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .lead-band .kicker { font-weight: 700; color: var(--color-accent-2); }
  .lead-band .score {
    margin-left: auto;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .lead h2 {
    margin: 0;
    font-size: clamp(30px, 4.4vw, 50px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }
  .lead .summary {
    margin: var(--space-4) 0 0;
    font-size: 16.5px;
    line-height: 1.55;
    hyphens: auto;
    text-wrap: pretty;
    columns: 2 18rem;
    column-gap: var(--space-6);
    column-rule: 1px solid var(--color-neutral-300);
  }
  /* The drop cap the artboard opens the lead with, taken from the text itself
     rather than split out in markup. */
  .lead .summary::first-letter {
    float: left;
    font-size: 62px;
    line-height: 0.8;
    font-weight: 700;
    padding: 4px var(--space-2) 0 0;
  }

  .why-lead {
    margin: var(--space-4) 0 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-accent-2);
    font-size: 16px;
    font-style: italic;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .why-lead strong {
    display: block;
    margin-bottom: 6px;
    font-style: normal;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-2);
  }
  .why-lead p { margin: 0; }

  .facts {
    margin: var(--space-6) 0 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--color-neutral-400);
    list-style: none;
    columns: 2 17rem;
    column-gap: var(--space-6);
  }
  .facts li {
    font-size: 13.5px;
    line-height: 1.4;
    padding: 0 0 var(--space-2) var(--space-4);
    text-indent: calc(-1 * var(--space-4));
    break-inside: avoid;
  }
  .facts li::before { content: "— "; color: var(--color-accent); font-weight: 700; }

  /* ---------- meta line ---------- */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding-top: var(--space-4);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .meta .source a { font-weight: 700; color: var(--color-text); white-space: nowrap; }
  .meta .published { white-space: nowrap; }
  .read-original { margin-left: auto; font-weight: 700; color: var(--color-accent-700); white-space: nowrap; }

  /* ---------- section headings ---------- */
  .section { padding-top: var(--space-6); }
  .rule-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-top: 3px solid var(--color-text);
    padding: var(--space-2) 0 var(--space-4);
  }
  .rule-row .fill { flex: 1 1 auto; height: 1px; background: var(--color-neutral-400); }
  .section-label {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .rule-row .count {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
    white-space: nowrap;
  }

  /* ---------- story grid ---------- */
  .stories { display: flex; flex-wrap: wrap; gap: var(--space-6); }
  .story-card {
    flex: 1 1 19rem;
    /* min() keeps a card from forcing the page wider than the phone it is read
       on: below 17rem of room the card simply takes the room there is. */
    min-width: min(17rem, 100%);
    padding-bottom: var(--space-4);
  }
  .story-card h3 {
    margin: 0 0 var(--space-2);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .story-card .summary {
    margin: 0 0 var(--space-2);
    font-size: 14.5px;
    line-height: 1.55;
    text-align: justify;
    hyphens: auto;
    text-wrap: pretty;
    columns: 2 19rem;
    column-gap: var(--space-6);
    column-rule: 1px solid var(--color-neutral-300);
  }
  .story-card .why {
    margin: 0 0 var(--space-2);
    font-size: 14px;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-neutral-800);
    text-wrap: pretty;
    columns: 2 19rem;
    column-gap: var(--space-6);
  }
  .why .label { font-style: normal; font-weight: 700; color: var(--color-accent-700); }
  .story-card .meta {
    display: block;
    border-top: 1px solid var(--color-neutral-300);
    padding-top: var(--space-2);
  }
  .story-card .meta .read-original { margin-left: 0; }

  /* ---------- reader call to action ---------- */
  .submit-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
    border-top: 4px solid var(--color-text);
    padding-top: var(--space-3);
  }
  .submit-cta p { margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.015em; }
  .submit-cta a {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-700);
    white-space: nowrap;
  }

  /* ---------- colophon ---------- */
  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-6);
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-neutral-400);
    padding-top: var(--space-3);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .colophon-note {
    margin: var(--space-2) 0 0;
    font-size: 12px;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-neutral-700);
  }

  /* ---------- wider screens ---------- */
  /* The artboard is drawn at desktop width and defines no breakpoints: its
     columns collapse on their own `Nrem` minimums. Only the rail needs one —
     a 330px float has nowhere to go on a phone. */
  @media (min-width: 46rem) {
    body { padding: var(--space-6) var(--space-4) var(--space-8); }
    .sidebar { float: right; width: 330px; margin: 0 0 var(--space-6) var(--space-6); }
  }

  @media print {
    /* Paging is a screen affordance; on paper it is an arrow nobody can follow. */
    .issue-nav { display: none; }
    body { background: #fff; padding: 0; font-size: 10.5pt; }
    .edition { max-width: none; }
    .sidebar { float: right; width: 300px; margin: 0 0 var(--space-6) var(--space-6); }
    .story-card, .brief-columns p, .facts li { break-inside: avoid; }
  }
</style>
</head>
<body>
<main class="edition">

  {% set items = edition.all_items() %}
  {% set issue_parts = edition.issue_label.split("-") %}
  {% set week_no = issue_parts[1][1:] if issue_parts | length == 2 and issue_parts[1][:1] == "W" else "" %}

  <header class="masthead">
    <div class="rule-heavy"></div>
    <div class="rule-hair"></div>

    <h1>{{ edition.masthead }}</h1>
    <p class="masthead-tagline">{{ tagline }}</p>

    <div class="rule-hair"></div>
    <div class="issue-strip">
      <span>{{ edition.period_start | issue_date }} &ndash; {{ edition.period_end | issue_date_end }}</span>
      <span class="issue-label">
        {% if week_no %}
        Semana {{ week_no }} &middot; {{ issue_parts[0] }}
        {% else %}
        {{ edition.issue_label }}
        {% endif %}
      </span>
      <span class="count">Resumen semanal &middot; {{ items | length }} {{ "nota" if items | length == 1 else "notas" }}
        {% if submit_url %}
        <a class="submit-button" href="{{ submit_url }}" target="_blank" rel="noopener noreferrer">Enviar un enlace &rarr;</a>
        {% endif %}
      </span>
    </div>
    <div class="rule-hair"></div>
    <nav class="issue-nav" aria-label="Navegación entre ediciones">
      {% if previous_issue %}
      <a href="{{ previous_issue.href }}" rel="prev">&larr; {{ previous_issue.text }}</a>
      {% else %}
      <span class="spent" aria-disabled="true">&larr; Semana anterior</span>
      {% endif %}
      {% if next_issue %}
      <a href="{{ next_issue.href }}" rel="next">{{ next_issue.text }} &rarr;</a>
      {% else %}
      <span class="spent" aria-disabled="true">Semana siguiente &rarr;</span>
      {% endif %}
    </nav>
    <div class="rule-mid"></div>
  </header>

  <section class="brief" aria-labelledby="brief-heading">
    <h2 class="brief-label" id="brief-heading">Lo esencial de la semana</h2>
    <div class="brief-columns">
      {% for bullet in edition.executive_summary %}
      <p><span class="n">{{ "%02d" | format(loop.index) }}</span>{{ bullet }}</p>
      {% endfor %}
    </div>
  </section>

  {% set lead = edition.lead_story %}
  {% set sidebar = edition.sections[0] if edition.sections else none %}
  <div class="body-matter">

    {% if sidebar %}
    <aside class="sidebar" aria-labelledby="sidebar-heading">
      <h2 id="sidebar-heading">{{ sidebar.title }}</h2>
      {% for item in sidebar.items %}
      <article class="story">
        <h3>
          <a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.headline }}</a>
        </h3>
        <p class="summary">{{ item.summary }}</p>
        <p class="why"><span class="label">Por qué importa: </span>{{ item.why_it_matters }}</p>
        <p class="meta">
          <span class="source"><a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.source_name }}</a></span>
          <span class="published">{{ item.published_at | issue_date }}</span>
          <a class="read-original" href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">Ver la fuente &rarr;</a>
        </p>
      </article>
      {% endfor %}
    </aside>
    {% endif %}

    <article class="lead" aria-labelledby="lead-heading">
      <div class="lead-band">
        <span class="kicker">Nota principal</span>
        <span class="category">{{ category_titles[lead.category] }}</span>
        <span class="score">{{ lead.score }}</span>
      </div>

      <h2 id="lead-heading">
        <a href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">{{ lead.headline }}</a>
      </h2>

      <p class="summary">{{ lead.summary }}</p>

      <div class="why-lead">
        <strong>Por qué importa</strong>
        <p>{{ lead.why_it_matters }}</p>
      </div>

      {% if lead.key_facts %}
      <ul class="facts">
        {% for fact in lead.key_facts %}
        <li>{{ fact }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      <p class="meta">
        <span class="source"><a href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">{{ lead.source_name }}</a></span>
        <span class="published">{{ lead.published_at | issue_date }}</span>
        <a class="read-original" href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">Ver la fuente &rarr;</a>
      </p>
    </article>

    {% for section in edition.sections[1:] %}
    <section class="section" aria-labelledby="section-{{ loop.index }}">
      <div class="rule-row">
        <span class="fill"></span>
        <h2 class="section-label" id="section-{{ loop.index }}">{{ section.title }}</h2>
        <span class="count">{{ section.items | length }} {{ "nota" if section.items | length == 1 else "notas" }}</span>
        <span class="fill"></span>
      </div>
      <div class="stories">
        {% for item in section.items %}
        <article class="story story-card">
          <h3>
            <a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.headline }}</a>
          </h3>
          <p class="summary">{{ item.summary }}</p>
          <p class="why"><span class="label">Por qué importa: </span>{{ item.why_it_matters }}</p>
          <p class="meta">
            <span class="source"><a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.source_name }}</a></span>
            <span class="published">&middot; {{ item.published_at | issue_date }} &middot;</span>
            <a class="read-original" href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">Ver la fuente &rarr;</a>
          </p>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endfor %}

  </div>

  {% if submit_url %}
  <aside class="submit-cta">
    <p>¿Viste algo que deberíamos cubrir esta semana?</p>
    <a href="{{ submit_url }}" target="_blank" rel="noopener noreferrer">Enviar un enlace &rarr;</a>
  </aside>
  {% endif %}

  <footer class="colophon">
    <span>{{ edition.masthead }} &middot; edición {{ edition.issue_label }}</span>
    <span>Generado el {{ edition.generated_at | issue_datetime }} a partir de {{ items | length }} {{ "nota" if items | length == 1 else "notas" }}</span>
  </footer>
  <p class="colophon-note">Cada titular lleva a su fuente original. Las notas se eligen por puntaje, no por patrocinio.</p>

</main>
</body>
</html>
