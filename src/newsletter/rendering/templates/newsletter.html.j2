{#
  The newspaper edition. Rendered from one NewsletterEdition object.

  Rules this template obeys:
  - autoescape is ON; no `| safe` anywhere, because headlines and summaries
    originate in scraped content;
  - every URL comes from `item.source_url`, which was validated at ingestion;
  - no JavaScript, no external requests: the file is readable offline, forever.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ edition.masthead }} — {{ edition.issue_label }}</title>
<meta name="description" content="Weekly enterprise intelligence briefing for {{ edition.period_start | issue_date }} to {{ edition.period_end | issue_date }}.">
<style>
  :root {
    --ink: #14110f;
    --ink-soft: #4a4440;
    --ink-faint: #767068;
    --paper: #fbfaf8;
    --rule: #d9d3ca;
    --rule-strong: #14110f;
    --accent: #8a1c1c;
    --serif: Georgia, "Iowan Old Style", "Times New Roman", Times, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: 2rem 1.25rem 4rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.55;
    -webkit-text-size-adjust: 100%;
  }

  .edition { max-width: 62rem; margin: 0 auto; }

  a { color: inherit; }
  a:hover, a:focus { color: var(--accent); }

  /* ---------- masthead ---------- */
  .masthead { text-align: center; padding-bottom: 1rem; border-bottom: 3px double var(--rule-strong); }
  .masthead h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    line-height: 1.05;
  }
  .masthead .tagline {
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.9rem;
  }
  .masthead .issue-line {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem;
    font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-soft);
    border-top: 1px solid var(--rule); padding-top: 0.75rem;
  }

  /* ---------- section headings ---------- */
  .section-label {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  /* ---------- executive brief ---------- */
  .brief ul { margin: 0; padding-left: 1.1rem; }
  .brief li { margin-bottom: 0.5rem; font-size: 1.02rem; }
  .brief li::marker { color: var(--accent); }

  /* ---------- lead story ---------- */
  .lead { padding-bottom: 1.75rem; border-bottom: 3px double var(--rule-strong); }
  .lead h2 {
    font-family: var(--serif);
    font-size: clamp(1.7rem, 4.4vw, 2.7rem);
    line-height: 1.14;
    margin: 0 0 0.75rem;
    font-weight: 700;
  }
  .lead h2 a { text-decoration: none; }
  .lead h2 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .lead .summary { font-family: var(--serif); font-size: 1.14rem; margin: 0 0 1rem; }

  .why {
    border-left: 3px solid var(--accent);
    padding: 0.15rem 0 0.15rem 0.9rem;
    margin: 0 0 1rem;
    color: var(--ink-soft);
  }
  .why strong {
    display: block;
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 0.15rem;
  }

  .facts { margin: 0 0 1rem; padding-left: 1.1rem; font-size: 0.95rem; color: var(--ink-soft); }
  .facts li { margin-bottom: 0.25rem; }

  /* ---------- meta line ---------- */
  .meta {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 0.85rem;
    font-size: 0.8rem; letter-spacing: 0.04em;
    color: var(--ink-faint);
    border-top: 1px solid var(--rule);
    padding-top: 0.6rem;
  }
  .meta .source { font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.1em; }
  .read-original { margin-left: auto; font-weight: 700; color: var(--accent); text-decoration: none; white-space: nowrap; }
  .read-original:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- story grid ---------- */
  .stories { display: grid; grid-template-columns: 1fr; gap: 1.75rem; }
  @media (min-width: 46rem) { .stories { grid-template-columns: 1fr 1fr; gap: 2rem 2.5rem; } }

  .story h3 {
    font-family: var(--serif);
    font-size: 1.28rem; line-height: 1.22; margin: 0 0 0.5rem; font-weight: 700;
  }
  .story h3 a { text-decoration: none; }
  .story h3 a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .story .summary { margin: 0 0 0.75rem; font-size: 0.97rem; }

  /* ---------- footer ---------- */
  .colophon {
    margin-top: 3rem; padding-top: 1rem;
    border-top: 3px double var(--rule-strong);
    font-size: 0.78rem; color: var(--ink-faint); text-align: center;
  }
  .colophon p { margin: 0.3rem 0; }

  @media print {
    body { background: #fff; padding: 0; font-size: 11pt; }
    .read-original { color: #000; }
    .stories { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
<body>
<main class="edition">

  <header class="masthead">
    <h1>{{ edition.masthead }}</h1>
    {% if tagline %}
    <p class="tagline">{{ tagline }}</p>
    {% endif %}
    <div class="issue-line">
      <span>Issue {{ edition.issue_label }}</span>
      <span>{{ edition.period_start | issue_date }} &ndash; {{ edition.period_end | issue_date }}</span>
      <span>{{ edition.all_items() | length }} stories</span>
    </div>
  </header>

  <section class="brief" aria-labelledby="brief-heading">
    <h2 class="section-label" id="brief-heading">Executive Brief</h2>
    <ul>
      {% for bullet in edition.executive_summary %}
      <li>{{ bullet }}</li>
      {% endfor %}
    </ul>
  </section>

  {% set lead = edition.lead_story %}
  <article class="lead" aria-labelledby="lead-heading">
    <h2 class="section-label">Lead Story</h2>
    <h2 id="lead-heading">
      <a href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">{{ lead.headline }}</a>
    </h2>
    <p class="summary">{{ lead.summary }}</p>
    <p class="why"><strong>Why it matters</strong>{{ lead.why_it_matters }}</p>
    {% if lead.key_facts %}
    <ul class="facts">
      {% for fact in lead.key_facts %}
      <li>{{ fact }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    <p class="meta">
      <span class="source"><a href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">{{ lead.source_name }}</a></span>
      <span>{{ lead.published_at | issue_date }}</span>
      <a class="read-original" href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">Read original &rarr;</a>
    </p>
  </article>

  {% for section in edition.sections %}
  <section aria-labelledby="section-{{ loop.index }}">
    <h2 class="section-label" id="section-{{ loop.index }}">{{ section.title }}</h2>
    <div class="stories">
      {% for item in section.items %}
      <article class="story">
        <h3>
          <a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.headline }}</a>
        </h3>
        <p class="summary">{{ item.summary }}</p>
        <p class="why"><strong>Why it matters</strong>{{ item.why_it_matters }}</p>
        <p class="meta">
          <span class="source"><a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.source_name }}</a></span>
          <span>{{ item.published_at | issue_date }}</span>
          <a class="read-original" href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">Read original &rarr;</a>
        </p>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  <footer class="colophon">
    <p>{{ edition.masthead }} &middot; Issue {{ edition.issue_label }}</p>
    <p>Generated {{ edition.generated_at | issue_datetime }} from {{ edition.all_items() | length }} selected stories.</p>
    <p>Every headline links to its original source. Nothing in this edition is behind a paywall of ours.</p>
  </footer>

</main>
</body>
</html>
