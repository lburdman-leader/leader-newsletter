{#
  The newspaper edition. Rendered from one NewsletterEdition object.

  Rules this template obeys:
  - autoescape is ON; no `| safe` anywhere, because headlines and summaries
    originate in scraped content;
  - every URL comes from `item.source_url`, which was validated at ingestion;
  - no JavaScript, no external requests, no webfont: the file is readable
    offline, forever, and prints without a network.

  Layout: masthead, executive brief as numbered cards, the lead story beside a
  filled sidebar carrying the first section, then the remaining sections as a
  card grid. The reference design is photo-led; this publication has no images,
  so the weight the photograph carried is given to the lead's "why it matters"
  block and to the accent fills.
#}
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ edition.masthead }} — {{ edition.issue_label }}</title>
<meta name="description" content="Resumen semanal de inteligencia para {{ edition.period_start | issue_date }} al {{ edition.period_end | issue_date_end }}.">
<style>
  :root {
    --accent: #1a44d6;
    --accent-ink: #ffffff;
    --ink: #14161d;
    --muted: #5b606c;
    --paper: #f3f1ec;
    --card: #ffffff;
    --rule: #d5d1c8;
    --sans: "Helvetica Neue", Helvetica, "Arial Nova", Arial, "Liberation Sans", sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    padding: 1.75rem 1.25rem 3rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.5;
    -webkit-text-size-adjust: 100%;
  }

  .edition { max-width: 65rem; margin: 0 auto; }

  a { color: inherit; text-decoration: none; }
  a:hover, a:focus { text-decoration: underline; text-underline-offset: 3px; }

  /* ---------- masthead ---------- */
  .masthead-top,
  .masthead-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .masthead-top { padding-bottom: 0.625rem; }
  .masthead-foot { padding-top: 0.625rem; letter-spacing: 0.04em; }

  .masthead-lockup {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: 1.125rem 0;
  }

  .issue-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    min-width: 6rem;
    padding: 0.625rem 0.75rem;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .issue-week { font-size: clamp(1.5rem, 5vw, 2.5rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .issue-year { font-size: 0.65rem; letter-spacing: 0.22em; margin-top: 0.25rem; }

  .wordmark {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .wordmark h1 {
    margin: 0;
    font-size: clamp(1.6rem, 4.6vw, 3.1rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.96;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .wordmark-accent { color: var(--accent); }

  /* ---------- section headings ---------- */
  .rule-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 2.25rem 0 1rem;
  }
  .rule-row .fill { flex-grow: 1; height: 2px; background: var(--ink); }
  .rule-row .count {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .section-label {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .section-label.eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* ---------- executive brief ---------- */
  .brief { display: grid; grid-template-columns: 1fr; gap: 1.125rem; }
  .brief-card {
    display: flex;
    gap: 0.875rem;
    background: var(--card);
    border: 1px solid var(--rule);
    padding: 1.125rem;
  }
  .brief-card .n {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.375rem;
    height: 2.375rem;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.95rem;
    font-weight: 800;
  }
  .brief-card p { margin: 0; font-size: 0.875rem; line-height: 1.45; }

  /* ---------- lead + sidebar ---------- */
  .lead-row { display: grid; grid-template-columns: 1fr; gap: 1.875rem; margin-top: 2.125rem; align-items: start; }

  .lead-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 0.75rem 1.125rem;
  }
  .lead-band .kicker { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }
  .lead-band .category { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.85; }
  .lead-band .score { font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }

  .lead h2 {
    margin: 1.25rem 0 0;
    font-size: clamp(1.75rem, 4.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.06;
    text-wrap: pretty;
  }
  .lead .summary { margin: 1rem 0 0; font-size: 1.0625rem; line-height: 1.5; }

  .why-lead {
    margin: 1.25rem 0 0;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 1.25rem 1.375rem;
  }
  .why-lead strong {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 0.375rem;
  }
  .why-lead p { margin: 0; font-size: 1.125rem; line-height: 1.42; text-wrap: pretty; }

  .facts { display: grid; grid-template-columns: 1fr; gap: 0.375rem 1.375rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }
  .facts li { display: flex; gap: 0.5625rem; font-size: 0.875rem; line-height: 1.4; }
  .facts li::before { content: "—"; color: var(--accent); font-weight: 800; }

  /* ---------- meta line ---------- */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.875rem;
    margin: 1.25rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta .source a { font-weight: 700; color: var(--ink); }
  .read-original { margin-left: auto; font-weight: 700; color: var(--accent); white-space: nowrap; }

  /* ---------- sidebar ---------- */
  .sidebar { background: var(--accent); color: var(--accent-ink); padding: 1.5rem 1.375rem; }
  .sidebar h2 {
    margin: 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .sidebar .story { padding: 1.125rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.35); }
  .sidebar .story:last-child { padding-bottom: 0; border-bottom: 0; }
  .sidebar .story h3 { margin: 0 0 0.5rem; font-size: 1.0625rem; font-weight: 700; line-height: 1.22; text-wrap: pretty; }
  .sidebar .story p { margin: 0 0 0.625rem; font-size: 0.8125rem; line-height: 1.45; opacity: 0.92; }
  .sidebar .why { border: 0; padding: 0; color: inherit; }
  .sidebar .why strong { color: inherit; }
  .sidebar .meta { border-top: 0; padding-top: 0; margin-top: 0.75rem; font-size: 0.62rem; color: inherit; opacity: 0.85; }
  .sidebar .meta .source a { color: inherit; }
  .sidebar .read-original { color: inherit; }

  /* ---------- story grid ---------- */
  .stories { display: grid; grid-template-columns: 1fr; gap: 1.625rem; }
  .story-card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    padding: 1.375rem;
  }
  .story-card h3 {
    margin: 0 0 0.625rem;
    font-size: 1.3125rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.18;
    text-wrap: pretty;
  }
  .story-card .summary { margin: 0 0 0.75rem; font-size: 0.875rem; line-height: 1.5; }
  .why {
    margin: 0;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .why strong { color: var(--ink); }
  .story-card .meta { margin-top: 1rem; padding-top: 0.625rem; }

  /* ---------- colophon ---------- */
  .colophon {
    margin-top: 2.75rem;
    padding-top: 1rem;
    border-top: 2px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .colophon-note { margin: 0.625rem 0 0; font-size: 0.7rem; line-height: 1.5; color: var(--muted); }

  /* ---------- reader call to action ---------- */
  .submit-cta {
    margin-top: 2.75rem;
    padding: 1.125rem 1.25rem;
    background: var(--accent);
    color: var(--accent-ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }
  .submit-cta p { margin: 0; font-size: 0.95rem; font-weight: 700; line-height: 1.35; }
  .submit-cta a {
    color: var(--accent-ink);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }

  /* ---------- wider screens ---------- */
  @media (min-width: 46rem) {
    body { padding: 2.75rem 2.75rem 3.5rem; }
    .brief { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lead-row { grid-template-columns: minmax(0, 1fr) 20rem; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stories { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.625rem 1.75rem; }
  }

  @media print {
    body { background: #fff; padding: 0; font-size: 10.5pt; }
    .edition { max-width: none; }
    .brief { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lead-row { grid-template-columns: minmax(0, 1fr) 18rem; }
    .stories { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .story-card, .brief-card { break-inside: avoid; }
  }
</style>
</head>
<body>
<main class="edition">

  {% set items = edition.all_items() %}
  {% set masthead_parts = edition.masthead.rsplit(" ", 1) %}
  {% set issue_parts = edition.issue_label.split("-") %}

  <header>
    <div class="masthead-top">
      <span>{{ edition.period_start | issue_date }} &ndash; {{ edition.period_end | issue_date_end }}</span>
      <span>Resumen semanal</span>
    </div>

    <div class="masthead-lockup">
      <div class="issue-block">
        <span class="issue-week">{{ issue_parts[-1] }}</span>
        {% if issue_parts | length > 1 %}
        <span class="issue-year">{{ issue_parts[0] }}</span>
        {% endif %}
      </div>
      <div class="wordmark">
        <h1>
          {% if masthead_parts | length == 2 %}
          {{ masthead_parts[0] }} <span class="wordmark-accent">{{ masthead_parts[1] }}</span>
          {% else %}
          {{ edition.masthead }}
          {% endif %}
        </h1>
      </div>
    </div>

    <div class="masthead-foot">
      <span>{{ tagline }}</span>
      <span>{{ items | length }} {{ "nota" if items | length == 1 else "notas" }}</span>
    </div>
  </header>

  <section aria-labelledby="brief-heading">
    <div class="rule-row">
      <h2 class="section-label eyebrow" id="brief-heading">Lo esencial de la semana</h2>
      <span class="fill"></span>
    </div>
    <div class="brief">
      {% for bullet in edition.executive_summary %}
      <div class="brief-card">
        <span class="n">{{ "%02d" | format(loop.index) }}</span>
        <p>{{ bullet }}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  {% set lead = edition.lead_story %}
  {% set sidebar = edition.sections[0] if edition.sections else none %}
  <div class="lead-row">

    <article class="lead" aria-labelledby="lead-heading">
      <div class="lead-band">
        <span class="kicker">Nota principal</span>
        <span class="category">{{ category_titles[lead.category] }}</span>
        <span class="score">{{ lead.score }}</span>
      </div>

      <h2 id="lead-heading">
        <a href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">{{ lead.headline }}</a>
      </h2>

      <p class="summary">{{ lead.summary }}</p>

      <div class="why-lead">
        <strong>Por qué importa</strong>
        <p>{{ lead.why_it_matters }}</p>
      </div>

      {% if lead.key_facts %}
      <ul class="facts">
        {% for fact in lead.key_facts %}
        <li>{{ fact }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      <p class="meta">
        <span class="source"><a href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">{{ lead.source_name }}</a></span>
        <span>{{ lead.published_at | issue_date }}</span>
        <a class="read-original" href="{{ lead.source_url }}" target="_blank" rel="noopener noreferrer">Ver la fuente &rarr;</a>
      </p>
    </article>

    {% if sidebar %}
    <aside class="sidebar" aria-labelledby="sidebar-heading">
      <h2 id="sidebar-heading">{{ sidebar.title }}</h2>
      {% for item in sidebar.items %}
      <article class="story">
        <h3>
          <a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.headline }}</a>
        </h3>
        <p class="summary">{{ item.summary }}</p>
        <p class="why"><strong>Por qué importa:</strong> {{ item.why_it_matters }}</p>
        <p class="meta">
          <span class="source"><a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.source_name }}</a></span>
          <span>{{ item.published_at | issue_date }}</span>
          <a class="read-original" href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">Ver la fuente &rarr;</a>
        </p>
      </article>
      {% endfor %}
    </aside>
    {% endif %}
  </div>

  {% for section in edition.sections[1:] %}
  <section aria-labelledby="section-{{ loop.index }}">
    <div class="rule-row">
      <h2 class="section-label" id="section-{{ loop.index }}">{{ section.title }}</h2>
      <span class="fill"></span>
      <span class="count">{{ section.items | length }} {{ "nota" if section.items | length == 1 else "notas" }}</span>
    </div>
    <div class="stories">
      {% for item in section.items %}
      <article class="story story-card">
        <h3>
          <a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.headline }}</a>
        </h3>
        <p class="summary">{{ item.summary }}</p>
        <p class="why"><strong>Por qué importa:</strong> {{ item.why_it_matters }}</p>
        <p class="meta">
          <span class="source"><a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">{{ item.source_name }}</a></span>
          <span>{{ item.published_at | issue_date }}</span>
          <a class="read-original" href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer">Ver la fuente &rarr;</a>
        </p>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endfor %}

  {% if submit_url %}
  <aside class="submit-cta">
    <p>¿Viste algo que deberíamos cubrir esta semana?</p>
    <a href="{{ submit_url }}" target="_blank" rel="noopener noreferrer">Enviar un enlace &rarr;</a>
  </aside>
  {% endif %}

  <footer class="colophon">
    <span>{{ edition.masthead }} &middot; edición {{ edition.issue_label }}</span>
    <span>Generado el {{ edition.generated_at | issue_datetime }} a partir de {{ items | length }} {{ "nota" if items | length == 1 else "notas" }}</span>
  </footer>
  <p class="colophon-note">Cada titular lleva a su fuente original. Las notas se eligen por puntaje, no por patrocinio.</p>

</main>
</body>
</html>
