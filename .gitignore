# --- secrets -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- generated editions --------------------------------------------------
output/
# The trailing glob also catches SQLite's WAL sidecars (-wal, -shm), which a
# bare *.sqlite does not match and which appear whenever a run is interrupted.
*.sqlite*
*.sqlite3
*.db

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.eggs/
*.egg-info/
build/
dist/

# --- tooling -------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- editors and os ------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- claude code ---------------------------------------------------------
.claude/settings.local.json

# --- local tooling and design references ---------------------------------
