# Copy to .env and fill in the key. Never commit .env.
# Behaviour that is not a secret belongs in config/*.yaml, not here.

# ---------------------------------------------------------------------------
# Required for live runs. Omit it and use --dry-run or the fixtures.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Models. These override the defaults in config/newsletter.yaml.
#
# The analyzer runs ONCE PER ARTICLE (dozens per run), against a strict schema:
# pick one of six categories, four 0-5 ratings, a factual summary, an
# interpretation, an event fingerprint. That is bounded classification and
# extraction with an explicit rubric, so the small tier does it well and keeps
# the run cheap.
#
# The editor runs ONCE PER EDITION and writes the prose a reader sees first,
# so it is worth the stronger model.
#
# Both must support strict Structured Outputs on the Responses API.
# Changing either model invalidates the assessment cache by design, so the next
# run re-analyses everything.
# ---------------------------------------------------------------------------
OPENAI_ANALYZER_MODEL=gpt-4.1-mini
OPENAI_EDITOR_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Paths (optional)
# ---------------------------------------------------------------------------
NEWSLETTER_DB_PATH=./newsletter.sqlite
NEWSLETTER_OUTPUT_DIR=./output

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
