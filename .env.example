# Copy to .env and fill in. Never commit .env.
# Behaviour that is not a secret belongs in config/*.yaml, not here.

# Required for live runs. Omit it and use --dry-run or fixtures.
OPENAI_API_KEY=

# Model selection (optional; sensible defaults live in config/newsletter.yaml)
OPENAI_ANALYZER_MODEL=
OPENAI_EDITOR_MODEL=

# Paths (optional)
NEWSLETTER_DB_PATH=./newsletter.sqlite
NEWSLETTER_OUTPUT_DIR=./output

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
